# ─── backend/.env.lambda.example ─────────────────────────────────────────────
#
# Copy this file to .env.lambda and fill in your production values.
# This file is read by the CDK stack and injected as Lambda environment vars.
# NEVER commit .env.lambda to git.
#
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@db.supabase.co:5432/postgres

# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_IMAGES_BUCKET=images

# ── LLM / AI ─────────────────────────────────────────────────────────────────
LLM_CHAT_PROVIDER=gemini
LLM_CHAT_API_KEY=AIza...
LLM_CHAT_MODEL=gemini-2.5-flash

LLM_EMBEDDING_PROVIDER=gemini
LLM_EMBEDDING_API_KEY=AIza...
LLM_EMBEDDING_MODEL=gemini-embedding-001

# ── RAG settings ─────────────────────────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RESULTS=15
MAX_TOOL_ITERATIONS=10
CACHE_THRESHOLD=0.07

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=https://your-frontend-domain.com
FRONTEND_URL=https://your-frontend-domain.com
APP_URL=https://your-api-gateway-url.execute-api.us-east-1.amazonaws.com

# ── Creem payments ────────────────────────────────────────────────────────────
CREEM_API_KEY=creem_live_...
CREEM_WEBHOOK_SECRET=whsec_...
CREEM_TEST_MODE=false

# ── WhatsApp ─────────────────────────────────────────────────────────────────
WHATSAPP_CREDENTIAL_ENCRYPTION_KEY=your-32-char-key
WHATSAPP_GRAPH_VERSION=v24.0

# ── Web scraping (optional) ──────────────────────────────────────────────────
SCRAPINGANT_API_KEY=
SCRAPINGANT_ENABLED=false
WEB_CRAWL_MAX_PAGES=30
